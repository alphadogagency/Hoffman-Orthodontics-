{
  "name": "hoffman-family-orthodontics",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "cf:preview": "wrangler dev --ip 127.0.0.1",
    "cf:validate": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "cf:deploy": "npm run build && wrangler deploy"
  },
  "dependencies": { "astro": "7.3.6" },
  "overrides": {
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3",
    "wrangler": "4.147.0"
  }
}
