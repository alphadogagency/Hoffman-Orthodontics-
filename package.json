{
  "name": "hoffman-family-orthodontics",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "cf:preview": "npm run pages:preview",
    "cf:validate": "npm run pages:validate",
    "cf:deploy": "npm run build && wrangler pages deploy dist --project-name hoffman-orthodontics",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "pages:preview": "wrangler pages dev dist --ip 127.0.0.1 --port 8788",
    "pages:validate": "wrangler pages functions build functions --outdir .wrangler/pages-functions"
  },
  "dependencies": {
    "astro": "7.3.6"
  },
  "overrides": {
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "^22.20.5",
    "typescript": "6.0.3",
    "wrangler": "4.147.0"
  }
}
