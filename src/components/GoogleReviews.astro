---
import { googleReviewsUrl } from '../lib/google-reviews';
import '../styles/reviews.css';
const enabled = import.meta.env.PUBLIC_ENABLE_GOOGLE_REVIEWS === 'true';
---
<section id="reviews" class="reviews-section section" aria-labelledby="reviews-title" data-reviews-enabled={String(enabled)}>
  <div class="container">
    <div class="section-heading"><div><p class="section-kicker">Patient perspectives</p><h2 id="reviews-title">Care, in their<br>own words.</h2></div><div><p>Read what patients have shared about their experience with Hoffman Family Orthodontics.</p><a class="text-link" href={googleReviewsUrl} target="_blank" rel="noopener noreferrer">Read our Google reviews</a></div></div>
    <p data-review-fallback class="reviews-fallback">Visit our Google profile to read patient reviews and share your experience.</p>
    <div data-review-content hidden>
      <div class="reviews-track" id="reviews-track" role="region" aria-label="Patient reviews" tabindex="0"></div>
      <div class="reviews-bottom"><div><img class="maps-logo" src="/assets/google-maps-attribution.svg" alt="Google Maps" height="18" loading="lazy" /><p class="review-selection">Five-star written reviews from Google’s selection, newest first. Google supplies up to five reviews; this is not the full review history.</p><div data-review-providers></div></div><div class="reviews-controls" data-review-controls hidden><button type="button" data-review-prev aria-label="Previous reviews" aria-controls="reviews-track">←</button><button type="button" data-review-next aria-label="Next reviews" aria-controls="reviews-track">→</button></div></div>
    </div>
    <template data-review-template><article class="review-card"><div class="review-stars" role="img" aria-label="5 out of 5 stars"><span aria-hidden="true">★★★★★</span></div><blockquote><p data-review-text dir="auto"></p></blockquote><button type="button" class="review-expand" data-review-expand aria-expanded="false" hidden>Read more</button><div class="review-person"><img data-review-avatar width="44" height="44" alt="" loading="lazy" referrerpolicy="no-referrer" hidden /><div><span data-review-author></span><time data-review-date hidden></time></div></div><a class="review-source" data-review-source target="_blank" rel="noopener noreferrer">Read on Google Maps ↗</a></article></template>
  </div>
</section>
<script>import '../scripts/google-reviews';</script>
