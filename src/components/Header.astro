---
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/about/', label: 'Meet Dr. Rachel' },
  { href: '/treatments/', label: 'Treatments' },
  { href: '/new-patients/', label: 'New patients' },
  { href: '/cost-and-financing/', label: 'Cost & financing' },
  { href: '/faq/', label: 'FAQs' },
];
---
  <div class="utility-bar"><div class="container utility-inner"><span>Your neighborhood orthodontist in East Memphis</span><a href="tel:+19016250202">Let’s talk smiles. <strong>901.625.0202</strong></a></div></div>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/" aria-label="Hoffman Family Orthodontics home"><img src="/assets/hoffman-logo.svg" width="203" height="55" alt="Hoffman Family Orthodontics"></a>
      <button class="menu-toggle" aria-controls="primary-nav" aria-expanded="false"><span>Menu</span><span class="menu-lines" aria-hidden="true"></span></button>
      <nav id="primary-nav" aria-label="Main navigation">
        {links.map(link => <a href={link.href} aria-current={currentPath === link.href.replace(/\/$/, '') ? 'page' : undefined}>{link.label}</a>)}
        <a class="button button-small" href="/contact/" aria-current={currentPath === '/contact' ? 'page' : undefined}>Contact us</a>
      </nav>
    </div>
  </header>
<script>
  import "../scripts/navigation";
</script>
