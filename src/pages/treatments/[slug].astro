---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConsultationCTA from '../../components/ConsultationCTA.astro';
import { treatments, type Treatment } from '../../data/treatments';
export function getStaticPaths() { return treatments.map(treatment => ({ params: { slug: treatment.slug }, props: { treatment } })); }
interface Props { treatment: Treatment }
const { treatment } = Astro.props;
const related = treatments.filter(item => treatment.related.includes(item.slug));
---
<BaseLayout title={`${treatment.title} | Hoffman Family Orthodontics`} description={treatment.intro}>
  <main id="main" class="interior-page">
    <section class="detail-intro"><div class="container"><a class="breadcrumb" href="/treatments/">Treatments /</a><h1>{treatment.title}</h1><p class="intro-lead">{treatment.intro}</p><a class="button" href="/contact/#form">Plan a complimentary consultation</a></div></section>
    <section class="section"><div class="container detail-grid"><aside class="detail-sidebar"><p class="section-kicker">A closer look</p><p>{treatment.lead}</p><a class="text-link" href="/cost-and-financing/">Cost &amp; financing</a></aside><div class="detail-body">{treatment.sections.map(section => <section class="reading-copy"><h2>{section.title}</h2>{section.paragraphs.map(paragraph => <p>{paragraph}</p>)}</section>)}</div></div></section>
    <section class="section pale-section"><div class="container editorial-grid"><h2>Before you decide.</h2><div class="faq-list">{treatment.questions.map(item => <details class="faq-item"><summary>{item.question}<span class="plus" aria-hidden="true"></span></summary><p>{item.answer}</p></details>)}<a class="text-link" href="/faq/">More questions &amp; answers</a></div></div></section>
    <section class="related-section"><div class="container"><h2>Explore your options</h2><nav class="related-links" aria-label="Related treatments">{related.map(item => <a href={`/treatments/${item.slug}/`}>{item.name}<span aria-hidden="true">↗</span></a>)}</nav></div></section>
    <ConsultationCTA />
  </main>
</BaseLayout>
