---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConsultationCTA from '../components/ConsultationCTA.astro';
import { doctorSchema } from '../data/practice';
---
<BaseLayout schema={[doctorSchema]} title="Meet Dr. Rachel Hoffman | Hoffman Family Orthodontics" description="Get to know Dr. Rachel Hoffman, a board-certified orthodontist offering personal, thoughtful care for families in East Memphis.">
  <main id="main" class="interior-page"><span id="dr-rachel-hoffman"></span>
    <section class="about-intro" aria-labelledby="about-title"><div class="container about-intro-grid">
      <div class="about-intro-copy"><p class="eyebrow">Meet your orthodontist</p><h1 id="about-title">Expert care.<br>A familiar <em>face.</em></h1><p class="intro-lead">Dr. Rachel Hoffman believes getting to know you is part of getting your care right.</p><p>At our East Memphis practice, she and her team bring together orthodontic expertise and a warm, personal approach. There’s room for your questions, your goals, and a treatment plan that fits you.</p><a class="text-link" href="#doctor">Get to know Dr. Rachel</a></div>
      <figure class="about-hero-portrait"><img src="/assets/dr-rachel.webp" alt="Dr. Rachel Hoffman" width="1200" height="1800" fetchpriority="high"><figcaption>Rachel A. Hoffman, MS, DDS, MS<br><span>Board-certified orthodontist</span></figcaption></figure>
    </div></section>
    <section class="section" id="doctor" aria-labelledby="approach-title"><div class="container editorial-grid"><div><p class="section-kicker">Her approach</p><h2 id="approach-title">Your care starts<br>with you.</h2></div><div class="reading-copy"><p class="intro-lead">Every patient brings a different smile, a different routine, and a different reason for being here.</p><p>Dr. Rachel takes a personalized approach to those needs. She and the Hoffman Family Orthodontics team stay current with advancements in orthodontics to create individualized treatment plans for children, teens, and adults.</p><p>Her goal is for you to feel comfortable throughout your orthodontic experience, understand your options, and enjoy a healthy, confident smile.</p></div></div></section>
    <section class="section pale-section" aria-labelledby="credentials-title"><div class="container editorial-grid"><div><h2 id="credentials-title">The experience<br>behind your care.</h2><p class="supporting-copy">Board-certified in Orthodontics &amp; Dentofacial Orthopedics.</p></div><div>
      <ol class="education-list"><li><span>Undergraduate studies</span><h3>University of Notre Dame</h3><p>Degree in Biology</p></li><li><span>Graduate studies</span><h3>Purdue University</h3><p>Master’s degree in Biology</p></li><li><span>Dental school</span><h3>Indiana University School of Dentistry</h3><p>Doctorate in dentistry · Indianapolis, Indiana</p></li><li><span>Orthodontic residency</span><h3>Oregon Health &amp; Science University</h3><p>Orthodontics &amp; Dentofacial Orthopedics · Portland, Oregon</p></li></ol>
      <div class="membership-note"><h3>Professional memberships</h3><ul><li>American Association of Orthodontists</li><li>Southern Society of Orthodontists</li><li>College of Diplomates of the American Board of Orthodontics</li></ul></div>
    </div></div></section>
    <section class="section" aria-labelledby="outside-title"><div class="container personal-story"><div><p class="section-kicker">Outside the office</p><h2 id="outside-title">A Midwesterner by birth.<br>A Memphian <em>at heart.</em></h2></div><div class="reading-copy"><p>Outside of orthodontics, Dr. Rachel loves cooking, discovering a good restaurant, listening to music, and giving her dog belly scratches. She and her husband, Terry, enjoy long walks and collecting vinyl records and artwork, some of which you’ll spot around the office.</p><p>She loves getting to know patients and their families, and she’s proud to both live and practice in Memphis.</p></div></div><div class="container community-note"><h3>Part of the East Memphis community</h3><p>Dr. Rachel and the team support local schools, health fairs, and volunteer events. Have an event or cause you’d like to share?</p><a class="text-link" href="/contact/">Get in touch with our team</a></div></section>
    <ConsultationCTA />
  </main>
</BaseLayout>
