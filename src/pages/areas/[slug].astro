---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConsultationCTA from '../../components/ConsultationCTA.astro';
import OfficeHours from '../../components/OfficeHours.astro';
import { areas } from '../../data/areas';
import { treatments } from '../../data/treatments';
export function getStaticPaths() { return areas.map(area => ({ params: { slug: area.slug }, props: { area } })); }
interface Props { area: typeof areas[number] }
const { area } = Astro.props;
const directions = `https://www.google.com/maps/dir/?api=1&origin=${encodeURIComponent(area.origin)}&destination=${encodeURIComponent('Hoffman Family Orthodontics, 5159 Wheelis Drive, Memphis, TN 38117')}`;
---
<BaseLayout title={`${area.heading} | Hoffman Family Orthodontics`} description={area.intro}>
  <main id="main" class="interior-page">
    <section class="detail-intro"><div class="container"><a class="breadcrumb" href="/areas/">Our Memphis community /</a><h1>{area.heading}</h1><p class="intro-lead">{area.intro}</p><a class="button" href="/contact/#form">Plan your first visit</a></div></section>
    <section class="section"><div class="container detail-grid"><aside class="detail-sidebar location-aside"><p class="section-kicker">One East Memphis office</p><address>5159 Wheelis Drive<br>Memphis, TN 38117</address><a class="text-link" href={directions} target="_blank" rel="noopener">Directions from {area.name}</a><OfficeHours /><a class="text-link" href="tel:+19016250202">Call 901.625.0202</a></aside><div class="detail-body"><section class="reading-copy"><h2>{area.title}</h2><p>{area.local}</p><p>{area.planning}</p></section><section class="reading-copy"><h2>{area.focusTitle}</h2><p>{area.focus}</p><p>Your consultation is complimentary. Photos, digital scans, X-rays, and an orthodontic exam help Dr. Rachel discuss a plan for your smile.</p><nav class="related-links" aria-label="Explore treatment options">{treatments.filter(t => area.links.includes(t.slug)).map(t => <a href={`/treatments/${t.slug}/`}>{t.name}<span aria-hidden="true">↗</span></a>)}</nav></section><section class="reading-copy"><h2>Know what comes next.</h2><p>Read about your first visit and how we approach insurance and flexible payment options before you come in.</p><div class="inline-links"><a class="text-link" href="/new-patients/">Your first visit</a><a class="text-link" href="/cost-and-financing/">Cost &amp; financing</a></div></section></div></div></section>
    <ConsultationCTA />
  </main>
</BaseLayout>
