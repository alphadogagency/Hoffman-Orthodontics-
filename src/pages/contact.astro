---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConsultationRequest from '../components/ConsultationRequest.astro';
import OfficeHours from '../components/OfficeHours.astro';
import { practice } from '../data/practice';
---
<BaseLayout title="Contact Our East Memphis Office | Hoffman Family Orthodontics" description="Contact Hoffman Family Orthodontics at 901.625.0202 or visit 5159 Wheelis Drive in Memphis to arrange a complimentary consultation with Dr. Rachel Hoffman.">
  <main id="main" class="interior-page">
    <section class="contact-page-intro" aria-labelledby="contact-page-title"><div class="container"><p class="eyebrow">Hoffman Family Orthodontics</p><h1 id="contact-page-title">Right here<br>in <em>East Memphis.</em></h1><p>Whether you’re ready to meet Dr. Rachel Hoffman or have a few questions first, we’d love to hear from you.</p></div></section>
    <section class="section contact-page-section" aria-label="Contact and consultation details"><div class="container contact-page-grid"><div class="office-details"><h2>Come say hello.</h2><address>5159 Wheelis Drive<br>Memphis, TN 38117</address><a class="text-link" href="https://maps.app.goo.gl/JrZmSSodFu2KYgvYA" target="_blank" rel="noopener">Get directions</a><dl class="contact-directory"><div><dt>Call</dt><dd><a href="tel:+19016250202">901.625.0202</a></dd></div><div><dt>Email</dt><dd><a href="mailto:info@hoffmanfamilyorthodontics.com">info@hoffmanfamilyorthodontics.com</a></dd></div><div><dt>Fax</dt><dd>901.425.0202</dd></div></dl><OfficeHours /><p class="office-service-area">Welcoming patients from East Memphis, Germantown, Downtown, Midtown, Collierville, Bartlett, and Cordova. <a class="text-link" href="/areas/">Plan a visit from your community</a></p><div class="social-links"><a href="https://www.instagram.com/hoffmanfamilyortho/" target="_blank" rel="noopener">Instagram</a><a href="https://www.facebook.com/hoffmanfamilyortho" target="_blank" rel="noopener">Facebook</a></div></div><ConsultationRequest /></div></section>
    <section class="map-section" aria-labelledby="map-title"><div class="container"><div class="map-heading"><div><h2 id="map-title">Find us on Wheelis Drive.</h2><p>5159 Wheelis Drive · Memphis, TN 38117</p></div><a class="text-link" href={practice.mapUrl} target="_blank" rel="noopener">Open directions in Google Maps</a></div><iframe title="Hoffman Family Orthodontics at 5159 Wheelis Drive, Memphis" src={practice.mapEmbed} width="1200" height="420" loading="lazy" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe></div></section>
    <section class="visit-reminder"><div class="container"><div><h2>Before you come in.</h2><p>See what to expect at your first appointment, from patient forms to your treatment discussion.</p></div><a class="text-link" href="/new-patients/">Explore your first visit</a></div></section>
  </main>
</BaseLayout>
